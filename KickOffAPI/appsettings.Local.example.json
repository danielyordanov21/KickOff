{
  "ConnectionStrings": {
    "AppDb": "Data Source=YOUR_SERVER;Initial Catalog=KickOffDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Command Timeout=0"
  },
  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net",
    "ContainerName": "media"
  },
  "Sendbird": {
    "AppId": "YOUR_SENDBIRD_APP_ID",
    "ApiToken": "YOUR_SENDBIRD_API_TOKEN"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "UserName": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromAddress": "no-reply@kickoff.example",
    "FromName": "KickOff",
    "EnableSsl": true
  },
  "Auth": {
    "ClientBaseUrl": "http://localhost:4200"
  },
  "ProjectNotifications": {
    "ClientBaseUrl": "http://localhost:4200"
  },
  "Jwt": {
    "Key": "YOUR_LONG_RANDOM_JWT_SIGNING_KEY",
    "Issuer": "KickOffAPI",
    "Audience": "KickOffClient",
    "ExpiresMinutes": 15
  },
  "DevelopmentSeed": {
    "AdminPassword": "CHANGE_ME_ADMIN_PASSWORD",
    "UserPassword": "CHANGE_ME_USER_PASSWORD"
  },
  "ProductionBootstrap": {
    "Enabled": false,
    "AdminEmail": "admin@kickoff.test",
    "AdminPassword": "CHANGE_ME_PRODUCTION_ADMIN_PASSWORD"
  }
}
